# Database (Neon PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Auth.js v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# Uploadthing (uploadthing.com)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"
UPLOADTHING_TOKEN="eyJ..."

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (optional, for audio analysis)
OPENAI_API_KEY="sk-proj-..."

# Resend (resend.com) — magic link email
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Legacy (unused, kept for compatibility)
MUSIC_STORAGE_BASE_URL="/audio"
COVER_BASE_URL="/covers"
