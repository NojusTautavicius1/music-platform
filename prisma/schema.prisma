generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime      @default(now())

  accounts           Account[]
  sessions           Session[]
  playlists          Playlist[]
  likedSongs         LikedSong[]
  playHistory        PlayHistory[]
  preferences        UserPreferences?
  generatedPlaylists GeneratedPlaylist[]
  agentQueries       AgentQuery[]
}

model UserPreferences {
  userId            String  @id
  defaultVolume     Float   @default(0.7)
  crossfadeSeconds  Int     @default(0)
  audioQuality      String  @default("auto")
  autoPlayEnabled   Boolean @default(true)
  emailNewPlaylists Boolean @default(true)
  emailWeekly       Boolean @default(true)
  profilePublic     Boolean @default(true)
  showActivity      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id                 String   @id @default(cuid())
  title              String
  artist             String
  album              String?
  genre              String?
  duration           Int
  audioUrl           String?
  coverUrl           String?
  waveformPeaks      Json?
  createdAt          DateTime @default(now())

  // Music file metadata (populated by import script)
  filePath           String?
  fileSize           Int?
  mimeType           String?
  bitrate            Int?
  sampleRate         Int?
  license            String?
  licenseAttribution String?
  sourceUrl          String?

  // Audio analysis fields (populated by audio-analyzer/analyze.py)
  bpm               Float?
  key               String?
  energy            Float?
  valence           Float?
  danceability      Float?
  acousticness      Float?
  instrumentalness  Float?
  mood              String?
  loudness          Float?
  analyzedAt        DateTime?

  // Embedding for semantic similarity search (text-embedding-3-small, 1536 dims)
  embedding         Unsupported("vector(1536)")?
  embeddingAt       DateTime?

  lyrics    Lyrics?

  playlists PlaylistSong[]
  likedBy   LikedSong[]
  history   PlayHistory[]

  @@index([title])
  @@index([artist])
  @@index([genre])
  @@index([mood])
  @@index([bpm])
}

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  sortOrder   Int      @default(0)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@index([userId, sortOrder])
}

model PlaylistSong {
  playlistId String
  songId     String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([playlistId, position])
}

model LikedSong {
  userId  String
  songId  String
  likedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([userId, likedAt])
}

model PlayHistory {
  id       String   @id @default(cuid())
  userId   String
  songId   String
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}

model Lyrics {
  id          String   @id @default(cuid())
  songId      String   @unique
  plainText   String?  @db.Text
  syncedJson  Json?
  language    String?
  source      String   @default("lrclib")
  fetchedAt   DateTime @default(now())

  // AI lyrical analysis
  sentiment   Float?
  themes      String[]
  mood        String?
  keyPhrases  String[]
  analyzedAt  DateTime?

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model GeneratedPlaylist {
  id           String   @id @default(cuid())
  userId       String
  kind         String   // 'daily-mix-1' | 'daily-mix-2' | 'discover-weekly' | 'on-repeat'
  name         String
  description  String
  coverUrl     String?
  gradientFrom String
  gradientTo   String
  songIds      String[]
  generatedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, generatedAt])
}

model AgentQuery {
  id               String   @id @default(cuid())
  userId           String?
  query            String
  resultCount      Int      @default(0)
  agentExplanation String?  @db.Text
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
